{
  "name": "MACNISS",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:push": "prisma db push",
    "auth:migrate": "tsx scripts/migrate-auth-merge.ts",
    "auth:create-user": "tsx scripts/create-cms-user.ts",
    "db:seed": "tsx prisma/seed.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:report": "playwright show-report",
    "verify": "npm run env:check && npm run typecheck && npm run db:validate && npm run test:e2e",
    "test:e2e:public": "playwright test tests/e2e/public-site.spec.ts tests/e2e/auth-security.spec.ts",
    "test:e2e:admin": "playwright test tests/e2e/admin-cms.spec.ts",
    "env:check": "tsx scripts/validate-env.ts",
    "test:e2e:api": "playwright test tests/e2e/api-contracts.spec.ts",
    "test:e2e:setup": "playwright test tests/e2e/first-run-setup.spec.ts",
    "first-run:status": "tsx scripts/first-run-status.ts",
    "routes:check": "tsx scripts/check-internal-routes.ts",
    "release:check": "npm run env:check && npm run routes:check && npm run typecheck && npm run db:validate && npm run test:e2e:final",
    "test:e2e:release": "playwright test tests/e2e/release-smoke.spec.ts tests/e2e/public-site.spec.ts tests/e2e/auth-security.spec.ts tests/e2e/api-contracts.spec.ts",
    "test:e2e:a11y": "playwright test tests/e2e/accessibility.spec.ts",
    "test:e2e:forms": "playwright test tests/e2e/forms-validation.spec.ts",
    "test:e2e:crud": "playwright test tests/e2e/crud-isolated.spec.ts",
    "test:e2e:final": "playwright test tests/e2e/release-smoke.spec.ts tests/e2e/accessibility.spec.ts tests/e2e/forms-validation.spec.ts tests/e2e/auth-security.spec.ts tests/e2e/api-contracts.spec.ts",
    "typecheck": "tsc --noEmit"
  },
