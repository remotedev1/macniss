    "dotenv": "^16.4.5",
    "imagekit": "^6.0.0",
    "imagekitio-next": "^1.0.1",
    "lucide-react": "^0.536.0",
    "next": "^14.2.30",
    "next-auth": "^5.0.0-beta.15",
    "next-themes": "^0.4.6",
    "nprogress": "^0.2.0",
    "react": "^18",
    "react-dom": "^18",
    "react-hook-form": "^7.51.1",
