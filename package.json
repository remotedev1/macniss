    "eslint": "^8",
    "eslint-config-next": "14.2.30",
    "postcss": "^8",
    "prisma": "5.22.0",
    "tailwindcss": "^3.3.0",
    "@playwright/test": "^1.54.2",
    "@axe-core/playwright": "^4.10.2",
    "typescript": "5.8.3",
    "@types/react-dom": "18.2.22",
    "tsx": "4.20.6"
  },
  "prisma": {
