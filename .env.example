# =============================================================================
# MACNISS — ENVIRONMENT CONFIGURATION
# Copy this file to `.env` for local development.
# Never commit a real `.env` file or production secrets.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. DATABASE — REQUIRED
# Prisma 5 + MongoDB.
# Local example:
#   mongodb://127.0.0.1:27017/macniss
# Atlas example:
#   mongodb+srv://USER:PASSWORD@CLUSTER/macniss?retryWrites=true&w=majority
# -----------------------------------------------------------------------------
MONGODB_URI="mongodb://127.0.0.1:27017/macniss"

# -----------------------------------------------------------------------------
# 2. AUTHENTICATION — REQUIRED
# Generate AUTH_SECRET with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Use a unique value in every environment.
# -----------------------------------------------------------------------------
AUTH_SECRET="REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS"
AUTH_TRUST_HOST="true"
NEXT_PUBLIC_APP_URL="http://localhost:3000"


# -----------------------------------------------------------------------------
# 3. PUBLIC BRANDING — OPTIONAL
# -----------------------------------------------------------------------------
NEXT_PUBLIC_COMPANY_NAME="Macniss Builders"

# -----------------------------------------------------------------------------
# 4. EMAIL / PASSWORD RECOVERY — OPTIONAL FOR LOCAL DEVELOPMENT
# If RESEND_API_KEY is empty, development can log reset/verification URLs
# instead of delivering them. Configure real credentials for staging/production.
# -----------------------------------------------------------------------------
RESEND_API_KEY=""
AUTH_EMAIL_FROM="Macniss <onboarding@resend.dev>"

# -----------------------------------------------------------------------------
# 5. IMAGEKIT — REQUIRED FOR CMS IMAGE UPLOADS
# NEXT_PUBLIC_* values are intentionally exposed to the browser.
# IMAGEKIT_PRIVATE_KEY must remain server-side only.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_PUBLIC_KEY=""
NEXT_PUBLIC_URL_ENDPOINT=""
IMAGEKIT_PRIVATE_KEY=""

# -----------------------------------------------------------------------------
# 6. ONE-TIME CMS USER CREATION — OPTIONAL
# Used only by:
#   npm run auth:create-user
# Prefer setting ADMIN_PASSWORD temporarily in your shell/CI secret store.
# -----------------------------------------------------------------------------
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD=""
ADMIN_FIRST_NAME="Site"
ADMIN_LAST_NAME="Administrator"

# -----------------------------------------------------------------------------
# 7. DEMO / DEVELOPMENT SEED USER — DEVELOPMENT ONLY
# Used by:
#   npm run db:seed
# Change SEED_USER_PASSWORD outside disposable local/demo databases.
# -----------------------------------------------------------------------------
SEED_USER_EMAIL="admin@macniss.local"
SEED_USER_PASSWORD="Macniss@Demo2026!"
SEED_USER_FIRST_NAME="Macniss"
SEED_USER_LAST_NAME="Admin"
SEED_USER_PHONE="9000000000"

# -----------------------------------------------------------------------------
# 8. PLAYWRIGHT E2E — OPTIONAL
# Authenticated admin tests use these credentials. They can match the seed user.
# -----------------------------------------------------------------------------
E2E_USER_EMAIL="admin@macniss.local"
E2E_USER_PASSWORD="Macniss@Demo2026!"
PLAYWRIGHT_BASE_URL="http://127.0.0.1:3000"
PLAYWRIGHT_PORT="3000"

# Set true only when a compatible app server is already running at BASE_URL.
PLAYWRIGHT_SKIP_WEBSERVER="false"

# -----------------------------------------------------------------------------
# 9. ISOLATED DESTRUCTIVE E2E — TEST DATABASE ONLY
# Both flags must be true before CRUD tests will modify data.
# Point MONGODB_URI at a disposable database before enabling them.
# -----------------------------------------------------------------------------
E2E_ALLOW_DESTRUCTIVE="false"
E2E_DATABASE_ISOLATED="false"
